{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Agent",
      "Read(**)",
      "WebFetch",
      "WebSearch",
      "Bash(peek:*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ps:*)",
      "Bash(osascript:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mdfind:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(git branch:*)",
      "Bash(dig:*)",
      "Bash(host:*)",
      "Bash(nslookup:*)",
      "Bash(nc:*)",
      "Bash(scutil:*)",
      "Bash(netstat:*)",
      "Bash(route:*)",
      "Bash(system_profiler:*)",
      "Bash(systemextensionsctl:*)",
      "Bash(launchctl list*)",
      "Bash(lsof:*)",
      "Bash(dscacheutil:*)",
      "Bash(pluginkit:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(defaults read*)",
      "Bash(plutil -p*)",
      "Bash(curl:*)",
      "Bash(sudo pfctl -s *)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(git push-base)",
      "Bash(git push-base *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh release *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git switch -c *)",
      "Bash(git switch -C *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git branch -c *)",
      "Bash(git branch -f *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-hook-edit"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-hook-notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-hook-stop"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": false,
    "excludedCommands": ["ps", "osascript", "gh", "git", "ssh", "nc"],
    "filesystem": {
      "denyRead": ["~/.ssh"]
    },
    "credentials": {
      "files": [
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" }
      ]
    }
  },
  "theme": "auto",
  "editorMode": "vim",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  }
}
