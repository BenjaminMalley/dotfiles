{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "WebFetch",
      "WebSearch",
      "Bash(peek:*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ps:*)",
      "Bash(osascript:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mdfind:*)",
      "Bash(fd:*)",
      "Bash(rg:*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push-base)",
      "Bash(git push-base *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh release *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git switch -c *)",
      "Bash(git switch -C *)",
      "Bash(git branch *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-hook-edit"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-hook-notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-hook-stop"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["ps", "osascript", "gh", "git", "ssh", "nc"],
    "filesystem": {
      "denyRead": ["~/.ssh"]
    },
    "credentials": {
      "files": [
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" }
      ]
    }
  },
  "theme": "auto",
  "editorMode": "vim",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  }
}
