#!/usr/bin/env python3
import sys
import os
import argparse

# Add repo root to sys.path to allow importing lib
repo_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, repo_root)

from lib.wts import add_repo, cleanup_session, create_session

def main():
    parser = argparse.ArgumentParser(description="Manage git worktrees and tmux sessions.")
    parser.add_argument("name", nargs="?", help="Branch name or session name")
    parser.add_argument("--done", "-d", action="store_true", help="Clean up current session")
    worktree_group = parser.add_mutually_exclusive_group()
    worktree_group.add_argument("--no-worktree", "-n", action="store_true", help="Create session without worktree")
    worktree_group.add_argument("--standalone", "-s", action="store_true",
                                 help="Create a session with no git repo, rooted at ~/sessions/<name>")
    parser.add_argument("--attach", "-a", action="store_true", help="Attach to session if it exists")
    parser.add_argument("--add", metavar="PATH", help="Add a worktree for another repo to the current session")

    args = parser.parse_args()

    if args.standalone and not args.name:
        parser.error("--standalone requires a session name")

    try:
        if args.done:
            cleanup_session()
        elif args.add:
            add_repo(args)
        elif not args.name and not args.no_worktree and not args.attach and not args.standalone:
            parser.print_help()
            sys.exit(1)
        else:
            create_session(args)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
